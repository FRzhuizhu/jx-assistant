<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 语音听写：网页 getUserMedia 需要应用持麦克风权限（仅放行已配对网关） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- WebView getUserMedia 的音频链还需要它（缺了报 NotReadableError:
         Could not start audio source——经典坑，普通权限，安装即生效） -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 浏览器常规配套（普通权限，安装即生效）：Chromium 网络状态感知 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+：下载完成通知（DownloadManager 进度/完成提示要它；
         危险权限，运行时随进设备页预申请，用户拒绝仅少通知、下载不受阻） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">

        <!-- 首页：设备列表 + 扫码连接/设置；冷启动按记忆直达设备页。
             launchMode 用默认（standard）：点桌面图标回应用时任务栈整体前移，
             停在原来的页面（此前是 singleTask——图标重启会把栈上的设备页全部清掉、
             永远回首页，2026-10-20 用户实测）。alwaysRetainTaskState 再兜一层：
             长时间在后台后图标重启也不重置到首页。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:alwaysRetainTaskState="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 扫码连接 -->
        <activity
            android:name=".ScanActivity"
            android:exported="false" />

        <!-- 系统分享入口：微信（文件「用其他应用打开」/图片视频「其他应用」）、
             文件管理器、浏览器等 → 复制到私有缓存后送进设备页输入框附件区 -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/AppTheme.Translucent">
            <!-- 分享（单个）：mime 全类型 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 分享（多选）：相册多选分享等 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 打开方式：微信文件预览页「用其他应用打开」走 ACTION_VIEW -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- 电脑页：全屏 WebView（每台电脑独立 Profile） -->
        <activity
            android:name=".DeviceActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- 设置：清空应用缓存 / 反馈意见 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />
    </application>
</manifest>
