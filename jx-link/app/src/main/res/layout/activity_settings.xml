<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="设置"
            android:textColor="@color/text1"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 区域一：清空应用缓存 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清空应用缓存"
                android:textColor="@color/text1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="清除所有电脑在本机的连接缓存与应用缓存\n（设备列表保留，不影响电脑端数据）"
                android:textColor="@color/text2"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/btn_clear_cache"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="清空应用缓存"
                android:textColor="@color/danger"
                android:textSize="15sp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- 区域二：反馈意见 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="反馈意见"
                android:textColor="@color/text1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="把问题或建议发给你当前可连上的电脑（与电脑端「问题反馈」同通道）"
                android:textColor="@color/text2"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <EditText
                android:id="@+id/fb_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_secondary"
                android:hint="标题（必填）"
                android:inputType="text"
                android:maxLength="120"
                android:padding="10dp"
                android:textSize="14sp"
                android:textColor="@color/text1"
                android:textColorHint="#B8BDC6" />

            <EditText
                android:id="@+id/fb_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:gravity="top"
                android:hint="详细描述（必填）"
                android:inputType="textMultiLine"
                android:maxLength="4000"
                android:minLines="3"
                android:padding="10dp"
                android:textSize="14sp"
                android:textColor="@color/text1"
                android:textColorHint="#B8BDC6" />

            <Button
                android:id="@+id/btn_feedback"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_primary"
                android:text="发送反馈"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
